# Copy this file to .env and adjust. .env is gitignored.
# ---------------------------------------------------------------------------

# Which ledger backend the whole pipeline uses. This is THE seam switch.
#   local -> LocalLedgerAdapter (default; fully working simulated chain)
#   evm   -> EVMLedgerAdapter   (teammate's on-chain adapter)
LEDGER_BACKEND=local

# Where the local hash-chained ledger file lives (LEDGER_BACKEND=local only).
LOCAL_LEDGER_PATH=data/ledger.json

# Salt applied before hashing face embeddings into a subject_hash.
# Keep this secret and stable; changing it changes every subject_hash.
# (A real deployment would use a per-install random salt kept out of git.)
SUBJECT_HASH_SALT=change-me-to-a-long-random-string

# --- Face stage (Phase 1) ------------------------------------------------
# Cosine-similarity threshold [0..1] to accept a pass-2 face match.
FACE_MATCH_THRESHOLD=0.5

# --- Search stage (Phase 3) ----------------------------------------------
# Reverse-image-search provider + key. TBD in Phase 3 (see decisions list).
# Leave blank until we choose one; nothing paid runs without your go-ahead.
RIS_PROVIDER=
RIS_API_KEY=
# Cache RIS responses to disk so re-runs don't burn quota (true/false).
SEARCH_CACHE_ENABLED=true

# --- EVM backend (teammate fills these in Phase later) -------------------
# Only read when LEDGER_BACKEND=evm. Never commit a real private key.
EVM_RPC_URL=
EVM_CONTRACT_ADDRESS=
EVM_CHAIN_ID=
# The teammate decides how a signer/key is supplied (env, keystore, wallet).
